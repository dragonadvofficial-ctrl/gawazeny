{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/admin_dashboard/index.html"
    },
    {
      "source": "/verify",
      "destination": "/admin_dashboard/verify.html"
    },
    {
      "source": "/(.*)",
      "destination": "/admin_dashboard/$1"
    }
  ]
}
